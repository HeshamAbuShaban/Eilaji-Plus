<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/destination_home">

    <fragment
        android:id="@+id/destination_home"
        android:name="dev.training.eilaji_plus.ui.fragments.user_interface.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/destination_chat"
        android:name="dev.training.eilaji_plus.ui.fragments.user_interface.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chatting" />

    <fragment
        android:id="@+id/destination_prescription"
        android:name="dev.training.eilaji_plus.ui.fragments.user_interface.prescription.PrescriptionFragment"
        android:label="Prescription"
        tools:layout="@layout/fragment_send_prescription" />

    <fragment
        android:id="@+id/destination_categories"
        android:name="dev.training.eilaji_plus.ui.fragments.user_interface.categories.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/destination_profile"
        android:name="dev.training.eilaji_plus.ui.fragments.user_interface.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Features -->
    <fragment
        android:id="@+id/destination_map"
        android:name="dev.training.eilaji_plus.ui.fragments.feat.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/destination_reminder"
        android:name="dev.training.eilaji_plus.ui.fragments.feat.ReminderFragment"
        android:label="Reminder"
        tools:layout="@layout/fragment_reminder" />

    <fragment
        android:id="@+id/destination_search"
        android:name="dev.training.eilaji_plus.ui.fragments.feat.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />


</navigation>